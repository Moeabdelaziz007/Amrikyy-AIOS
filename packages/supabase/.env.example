# Environment Variables for Supabase

# Supabase Project URL
# Get this from your Supabase project settings
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public Key)
# This is safe to use in the browser
# Get this from your Supabase project API settings
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Backend Only)
# ⚠️ NEVER expose this in the frontend!
# Only use in backend/server code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
